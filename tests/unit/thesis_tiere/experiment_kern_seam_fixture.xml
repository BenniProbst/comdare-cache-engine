<!-- KERN #48-S4 TEST-FIXTURE (ce-lokal, 2026-07-22). Spiegelt die KERN-Elemente der kanonischen Referenz
     super Code/test_data_xml/experiment_golden_kern.xml fuer die Parser-/Validator-Naht-Tests (KEIN Sync-Gate;
     rein test-lokal). Diese Instanz ist BEWUSST valide (validate_experiment_profile ok=true ohne registry_dir):
     sie ergaenzt die fuer die Validierung erforderlichen Felder (op_types required, lebewesen fuer phase.pruefling)
     ueber die reine Struktur-Referenz hinaus. Traegt alle vier neuen #48-S4-Elemente:
       - <machines> mit Kern-Identitaets-Schluessel (cpu_fabrication + ram_pair; hostname_hint nur Hinweis)
       - <axes_default_lookup><axis pruefling=..> (engine-id / lebewesen-id / self-Marker)
       - merge="union" (dritter Token, hier mit Phase-3-Bindung ueber <phase merge="Verbund3_Union">)
       - <output><storage backend=.. endpoint=..> (inert) -->
<!-- UMBENANNT 2026-08-17 (Scheibe 6 / Weg a, AUDIT-VERDIKT 20260722 Befund C5): diese Datei hiess frueher
     experiment_golden_kern.xml und damit GLEICH wie die kanonische super-Instanz
     Code/test_data_xml/experiment_golden_kern.xml, ohne deren Kopie zu sein. Der Name ist jetzt eindeutig.
     Die Umbenennung war WERT-NEUTRAL: kein einziger Wert dieser Datei hat sich dabei bewegt.

     LESER DIESER FIXTURE (beide ueber das Compile-Define COMDARE_EXPERIMENT_KERN_SEAM_FIXTURE):
       1. tests/unit/thesis_tiere/test_experiment_kern_seam.cpp (6 der 15 TESTs lesen die Datei)
       2. tests/unit/test_s3_ordnung_freigabe.cpp (S-3c, alle 6 TESTs; "dieselbe Parser-Flaeche")

     ABSICHTLICHE DIVERGENZ ZUM MASTER. Das ist KEIN Drift, sondern der Testgegenstand: jede der folgenden
     Zeilen hat einen literalen Beleg in test_experiment_kern_seam.cpp (TEST-Name in Klammern;
     Namens-Anker statt Zeilennummern, weil die Datei lebt und Zeilen driften; Lens-Fund 17.08.:
     alle sechs frueheren Zeilenangaben lagen nach EINEM Include-Shift um +1 daneben).
       - lebewesen: 3 statt 7 Tiere. Minimalmenge, die phase@pruefling="prt_art" aufloesbar macht.
       - axis search_algo pruefling="ee_prt" statt "prt_art": uebt den ENGINE-id-Zweig
         (ParsesAxisPrueflingAndFulljoinToken)
       - axis path_compression merge="union" statt "merge": der EINZIGE Positiv-Lauf des
         dritten merge-Tokens samt Phase-3-Bindung        (ParsesAxisPrueflingAndFulljoinToken)
       - dritte Achse mapping pruefling="self": uebt den self-Marker-Zweig
         (ParsesAxisPrueflingAndFulljoinToken)
       - storage backend="minio" mit endpoint statt backend="local": uebt den
         endpoint-tragenden Zweig                                          (ParsesStorageSlot)
       - KEINE OS- und KEINE RAM-Attribute an <machine>: die ABWESENHEIT ist load-bearing
         (Byte-Identitaets-Zusicherung additiver Attribute)
         (ParsesMachinesWithCoreIdentity, MachinesWithoutOsExpectationStayEmpty)
     WER DIESE WERTE AN DEN MASTER ANGLEICHT, LOESCHT DIE BEWEISE. Schema-Evolution dagegen MUSS
     nachgezogen werden: die Datei wird gegen dieselbe Single-Source-XSD auf Vokabular geprueft
     (ce tests/unit/fixture_schema_subset_check.cmake; das Schema-Bein zieht super
     Code/test_data_xml/experiment_schema.xsd). -->
<comdare_experiment version="2" id="diplomarbeit_golden_kern_fixture"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:noNamespaceSchemaLocation="experiment_schema.xsd">

  <metadata>
    <name>diplomarbeit_golden_kern_fixture</name>
    <mode>full</mode>
  </metadata>

  <execution_engines>
    <engine id="ee_ce"  type="CacheEngineExecutionEngineAdapter" registry="cache_engine_axis_registry.xml"/>
    <engine id="ee_prt" type="PrtArtExecutionEngineAdapter"      registry="prt_art_axis_registry.xml"/>
  </execution_engines>

  <!-- KERN #48-S4: Maschinen-Menge (Section 62-C). Kern-Identitaet = cpu_fabrication + ram_pair; hostname nur Hint. -->
  <machines>
    <machine id="prod1" cpu_fabrication="amd_zen5_avx512" ram_pair="ddr5_2x32" hostname_hint="prod1"/>
    <machine id="prod2" cpu_fabrication="intel_avx2"      ram_pair="ddr5_2x32" hostname_hint="prod2"/>
  </machines>

  <lebewesen>
    <tier id="prt_art"/>
    <tier id="art"/>
    <tier id="hot"/>
  </lebewesen>

  <phases>
    <phase name="Verbund1_CeOnly"           merge="Verbund1_CeOnly"           engine="ee_ce"/>
    <phase name="Verbund2_Replace" merge="Verbund2_Replace" engine="ee_prt" pruefling="prt_art" id_namespace="merge_prt_v1"/>
    <phase name="Verbund3_Union"         merge="Verbund3_Union"         engines="ee_ce ee_prt" pruefling="prt_art" id_namespace="join_prt_v1"/>
  </phases>

  <!-- KERN #48-S4: per-Achse pruefling + union-Token (Phase-3-Bindung liegt oben vor). -->
  <axes_default_lookup enabled="true">
    <axis ref="search_algo"      pruefling="ee_prt"  merge="replace"  allowed_variants="k_ary interpolation"/>
    <axis ref="path_compression" pruefling="prt_art" merge="union"/>
    <axis ref="mapping"          pruefling="self"    merge="merge"/>
  </axes_default_lookup>

  <system_axes>
    <compiler>
      <opt_level>
        <option value="O2"/>
        <option value="O3"/>
      </opt_level>
    </compiler>
    <external_utils>
      <simd>
        <option value="no_extension"/>
        <option value="avx2"/>
      </simd>
    </external_utils>
  </system_axes>

  <workloads>ycsb_a ycsb_b ycsb_c ycsb_d ycsb_e ycsb_f</workloads>

  <op_types>OP-1 OP-3</op_types>

  <output>
    <binary_path>golden_kern/measurements/all_permutations.bin</binary_path>
    <csv_path>golden_kern/measurements.csv</csv_path>
    <latex_path>golden_kern/golden_kern_table.tex</latex_path>
    <!-- KERN #48-S4: inert deklarierter Storage-Slot (Konsum K7b/K8 post-Abgabe). -->
    <storage backend="minio" endpoint="minio.comdare.local"/>
  </output>

</comdare_experiment>
