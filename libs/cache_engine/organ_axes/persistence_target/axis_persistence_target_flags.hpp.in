#pragma once
// STRUKT-R ORG-18 axis_persistence_target CMake-generierter Flags-Header
//
// Owner-Entscheid Q-1 = FALL B: disk_writeback existiert VOLLSTAENDIG als Baustein (Typ, Registry,
// Stempel, binary_id-Segment), ist aber per option() AUS -> EnabledTargets bleibt 1-elementig und der
// Voll-Bau-Raum bleibt 2^17. Aufschaltung spaeter ohne Code-Aenderung (nur option() umstellen), sobald
// axis_persistence_target_disk_writeback.hpp einen echten Geraete-Schreibpfad traegt.

#cmakedefine01 COMDARE_AXIS_PERSISTENCE_USE_MEMORY_ONLY
#cmakedefine01 COMDARE_AXIS_PERSISTENCE_USE_DISK_WRITEBACK

namespace comdare::cache_engine::persistence_target::flags {

inline constexpr bool memory_only_enabled    = COMDARE_AXIS_PERSISTENCE_USE_MEMORY_ONLY;
inline constexpr bool disk_writeback_enabled = COMDARE_AXIS_PERSISTENCE_USE_DISK_WRITEBACK;

}  // namespace
